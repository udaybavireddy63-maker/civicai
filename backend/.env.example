PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/civicai?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_jwt_secret_key
CLIENT_ORIGIN=http://localhost:5173
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
ADMIN_SEED_EMAIL=admin@civicai.org
ADMIN_SEED_PASSWORD=replace_with_secure_admin_password
ADMIN_SEED_NAME=Municipal Administrator

# Image Storage Configuration (local for dev, cloudinary for Render/production)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
